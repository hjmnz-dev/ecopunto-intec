---
// Ícono de trazo de Lucide (licencia ISC, ver src/icons/LICENSE-lucide.txt).
// Para sumar uno: copia su SVG a src/icons/ y agrega el nombre a NombreIcono.
export type NombreIcono =
  | 'check' | 'x' | 'clipboard-list' | 'users' | 'trending-up' | 'recycle'
  // Guía (spec 0003): sí, no y pasos
  | 'plug-zap' | 'cable' | 'mouse' | 'keyboard' | 'headphones' | 'calculator' | 'usb' | 'cpu'
  | 'apple' | 'cup-soda' | 'milk' | 'scroll-text' | 'leaf' | 'droplets' | 'trash-2'
  | 'search' | 'shuffle' | 'smartphone';

interface Props {
  nombre: NombreIcono;
  tamano?: string;
  etiqueta?: string;
}

const { nombre, tamano = '1.5rem', etiqueta } = Astro.props;

const archivos = import.meta.glob<string>('../../icons/*.svg', { query: '?raw', import: 'default', eager: true });
const svg = archivos[`../../icons/${nombre}.svg`];
if (!svg) {
  throw new Error(`Ícono "${nombre}" sin archivo en src/icons/${nombre}.svg`);
}
---

<span
  class="icono"
  style={`--tamano: ${tamano}`}
  role={etiqueta ? 'img' : undefined}
  aria-label={etiqueta}
  aria-hidden={etiqueta ? undefined : 'true'}
  set:html={svg}
/>

<style>
  .icono {
    display: inline-block;
    flex: none;
    width: var(--tamano);
    height: var(--tamano);
    color: currentColor;
  }
  .icono :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
