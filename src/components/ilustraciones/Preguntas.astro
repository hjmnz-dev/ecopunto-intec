---
// Signos de pregunta y flechas sin rumbo alrededor del cargador perdido (spec 0003).
// Caja local de 300 × 220. Partes animables: pregunta-1..3, flecha-1..3.
interface Props {
  x?: number;
  y?: number;
}

const { x = 0, y = 0 } = Astro.props;
---

<g data-parte="preguntas" transform={`translate(${x} ${y})`}>
  <text data-parte="pregunta-1" class="ilu-texto ilu-tinta" x="30" y="60" font-size="54">
    ?
  </text>
  <text data-parte="pregunta-2" class="ilu-texto ilu-verde" x="245" y="50" font-size="64">
    ?
  </text>
  <text data-parte="pregunta-3" class="ilu-texto ilu-tinta" x="255" y="200" font-size="48">
    ?
  </text>
  <g data-parte="flecha-1">
    <path class="ilu-trazo ilu-linea" d="M70 150 C40 160 30 190 50 205" />
    <path class="ilu-trazo ilu-linea" d="M42 196 L50 205 L60 198" />
  </g>
  <g data-parte="flecha-2">
    <path class="ilu-trazo ilu-linea" d="M200 30 C230 20 240 0 230 -12" />
    <path class="ilu-trazo ilu-linea" d="M222 -6 L230 -12 L236 -3" />
  </g>
  <g data-parte="flecha-3">
    <path class="ilu-trazo ilu-linea" d="M230 130 C262 130 280 110 286 92" />
    <path class="ilu-trazo ilu-linea" d="M278 96 L286 92 L290 101" />
  </g>
</g>
