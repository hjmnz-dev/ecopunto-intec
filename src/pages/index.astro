---
// La página como historia al hacer scroll (spec 0003). Este HTML es el modo estático completo;
// src/scripts/escenas/ activa el modo fijo de cada escena cuando hay movimiento.
import Base from '../layouts/Base.astro';
import Seccion from '../components/ui/Seccion.astro';
import TituloSeccion from '../components/ui/TituloSeccion.astro';
import TarjetaCinta from '../components/ui/TarjetaCinta.astro';
import ListaIconos from '../components/ui/ListaIconos.astro';
import Escena from '../components/historia/Escena.astro';
import Momento from '../components/historia/Momento.astro';
import Guia from '../components/historia/Guia.astro';
import Juego from '../components/historia/Juego.astro';
import Cargador from '../components/ilustraciones/Cargador.astro';
import Celular from '../components/ilustraciones/Celular.astro';
import Cajon from '../components/ilustraciones/Cajon.astro';
import Basurero from '../components/ilustraciones/Basurero.astro';
import Contenedor from '../components/ilustraciones/Contenedor.astro';
import Preguntas from '../components/ilustraciones/Preguntas.astro';
import { campana } from '../data/campana';

const { historia, encuesta, objetivoGeneral, acciones, sobre, cierre, creditos } = campana;
const escena = Object.fromEntries(historia.escenas.map((e) => [e.id, e])) as Record<
  (typeof historia.escenas)[number]['id'],
  (typeof historia.escenas)[number]
>;
const etiqueta = (id: string) => `titulo-${id}`;
---

<Base titulo={campana.meta.titulo} descripcion={campana.meta.descripcion}>
  <a class="saltar" href="#guia">
    {historia.saltar}
  </a>
  <main>
    <header class="portada">
      <div class="portada-contenido">
        <div class="portada-texto">
          <h1 class="marca">{campana.nombre}</h1>
          <p class="lema" data-entrada="1">
            {campana.lema}
          </p>
          <p class="subtitulo" data-entrada="1">
            {campana.subtitulo}
          </p>
        </div>
        <div class="portada-dibujo" data-entrada="2">
          <svg class="lienzo" viewBox="0 0 400 300" aria-hidden="true">
            <Celular pose="cargando" x={250} y={120} escala={1.1} />
            <Cargador pose="enchufado" x={110} y={20} escala={1.4} />
          </svg>
        </div>
        <p class="pista" data-entrada="3">
          <span class="flecha" data-pista aria-hidden="true">
            ↓
          </span>{' '}
          {historia.pista}
        </p>
      </div>
    </header>

    <Escena id="funciona" etiqueta={etiqueta('funciona')}>
      <svg slot="dibujo" class="lienzo" viewBox="0 0 400 300" aria-hidden="true">
        <Celular pose="apagado" x={250} y={120} escala={1.1} />
        <Cargador pose="roto" x={110} y={20} escala={1.4} />
      </svg>
      {escena.funciona.momentos.map((m, i) => (
        <Momento
          momento={m}
          indice={i}
          id={i === 0 ? etiqueta('funciona') : undefined}
          giro={i === 0 ? 'izquierda' : 'derecha'}
        />
      ))}
    </Escena>

    <Escena id="cajon" etiqueta={etiqueta('cajon')}>
      <svg slot="dibujo" class="lienzo" viewBox="0 0 400 300" aria-hidden="true">
        <Cajon x={65} y={120} escala={1.5}>
          <Cargador slot="dentro" pose="guardado" x={40} y={-30} escala={0.8} giro={-12} />
        </Cajon>
      </svg>
      <Momento momento={escena.cajon.momentos[0]} indice={0} id={etiqueta('cajon')} giro="derecha" />
    </Escena>

    <Escena id="basura" tono="noche" etiqueta={etiqueta('basura')}>
      <svg slot="dibujo" class="lienzo" viewBox="0 0 400 300" aria-hidden="true">
        <Basurero x={130} y={40} escala={1.45}>
          <Cargador slot="dentro" pose="basura" x={25} y={-20} escala={0.75} giro={18} />
        </Basurero>
      </svg>
      <Momento momento={escena.basura.momentos[0]} indice={0} id={etiqueta('basura')} giro="izquierda" />
    </Escena>

    <Escena id="nadie-sabe" etiqueta={etiqueta('nadie-sabe')}>
      <svg slot="dibujo" class="lienzo" viewBox="0 0 400 300" aria-hidden="true">
        <Preguntas x={50} y={50} />
        <Cargador pose="perdido" x={140} y={60} escala={1.2} />
      </svg>
      <Momento momento={escena['nadie-sabe'].momentos[0]} indice={0} id={etiqueta('nadie-sabe')} giro="derecha" />
    </Escena>

    <Escena id="ecopunto" etiqueta={etiqueta('ecopunto')}>
      <svg slot="dibujo" class="lienzo" viewBox="0 0 400 300" aria-hidden="true">
        <Contenedor x={130} y={30} escala={1.05}>
          <Cargador slot="dentro" pose="reciclado" x={45} y={-55} escala={0.8} />
        </Contenedor>
      </svg>
      {escena.ecopunto.momentos.map((m, i) => (
        <Momento
          momento={m}
          indice={i}
          id={i === 0 ? etiqueta('ecopunto') : undefined}
          giro={i === 0 ? 'izquierda' : 'derecha'}
        />
      ))}
    </Escena>

    <Guia />

    <Juego />

    <Seccion id="sobre">
      <TituloSeccion>{sobre.titulo}</TituloSeccion>
      <div class="grilla">
        <TarjetaCinta giro="izquierda" as="article">
          <h3 class="subtitulo-tarjeta">{encuesta.titulo}</h3>
          <ListaIconos
            items={[
              { icono: 'clipboard-list', texto: encuesta.metodo[0] },
              { icono: 'users', texto: encuesta.metodo[1] },
              { icono: 'trending-up', texto: encuesta.metodo[2] },
            ]}
          />
        </TarjetaCinta>
        <TarjetaCinta papel="salvia" cinta="lados" as="article">
          <h3 class="subtitulo-tarjeta">{objetivoGeneral.titulo}</h3>
          <p>{objetivoGeneral.texto}</p>
        </TarjetaCinta>
        <TarjetaCinta giro="derecha" cinta="esquinas" as="article">
          <h3 class="subtitulo-tarjeta">{acciones.titulo}</h3>
          <ul class="acciones">
            {acciones.puntos.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </TarjetaCinta>
      </div>
    </Seccion>

    <Seccion id="cierre" ancho="texto">
      <TituloSeccion>{cierre.titulo}</TituloSeccion>
      <TarjetaCinta cinta="esquinas" giro="izquierda">
        <svg class="lienzo dibujo-cierre" viewBox="0 0 400 300" aria-hidden="true">
          <Contenedor x={130} y={30} escala={1.05}>
            <Cargador slot="dentro" pose="reciclado" x={45} y={-55} escala={0.8} />
          </Contenedor>
        </svg>
        <p class="cierre-sub">{cierre.subtitulo}</p>
      </TarjetaCinta>
    </Seccion>
  </main>
  <footer class="pie">
    <p>
      <strong>{creditos.proyecto}</strong> · {creditos.institucion}
    </p>
  </footer>
</Base>

<style>
  .saltar {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--espacio-2) var(--margen-lateral);
    background: var(--color-papel);
    color: var(--color-tinta);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    box-shadow: var(--sombra-papel);
    position: relative;
    z-index: 2;
  }

  .portada {
    background: var(--color-portada);
    min-height: 90vh;
    min-height: 90svh;
    display: grid;
    align-items: center;
    padding: var(--espacio-5) var(--margen-lateral);
  }
  .portada-contenido {
    width: 100%;
    max-width: var(--ancho-seccion);
    margin-inline: auto;
    display: grid;
    gap: var(--espacio-4);
  }
  .marca {
    font-size: var(--titulo-portada);
    color: var(--color-tinta);
    overflow-wrap: anywhere;
  }
  .lema {
    margin-top: var(--espacio-3);
    font-family: var(--font-titulo);
    font-weight: 900;
    font-size: var(--titulo-historia);
    color: var(--color-verde);
    text-transform: uppercase;
  }
  .subtitulo {
    margin-top: var(--espacio-2);
    max-width: var(--ancho-texto);
  }
  .portada-dibujo {
    height: clamp(12rem, 55vw, 22rem);
  }
  .pista {
    display: flex;
    align-items: center;
    gap: var(--espacio-2);
    font-weight: 700;
  }
  .flecha {
    display: inline-block;
    font-size: var(--titulo-historia);
    color: var(--color-verde);
  }
  @media (min-width: 1024px) {
    .portada-contenido {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
    .pista {
      grid-column: 1 / -1;
    }
  }

  .subtitulo-tarjeta {
    font-size: var(--titulo-historia);
    text-transform: none;
    margin-bottom: var(--espacio-3);
  }
  .acciones {
    margin: 0;
    padding-left: var(--espacio-4);
    display: grid;
    gap: var(--espacio-2);
  }
  .dibujo-cierre {
    height: clamp(12rem, 50vw, 18rem);
  }
  .cierre-sub {
    margin-top: var(--espacio-3);
    text-align: center;
    font-family: var(--font-titulo);
    font-weight: 900;
    font-size: var(--titulo-historia);
    text-transform: uppercase;
  }

  .pie {
    padding: var(--espacio-4) var(--margen-lateral);
    background: var(--color-papel);
    text-align: center;
    box-shadow: var(--sombra-papel);
  }
</style>
