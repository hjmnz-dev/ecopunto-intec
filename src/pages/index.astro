---
import Base from '../layouts/Base.astro';
import Seccion from '../components/ui/Seccion.astro';
import TituloSeccion from '../components/ui/TituloSeccion.astro';
import TarjetaCinta from '../components/ui/TarjetaCinta.astro';
import BloqueDato from '../components/ui/BloqueDato.astro';
import ListaIconos from '../components/ui/ListaIconos.astro';
import ImagenMarco from '../components/ui/ImagenMarco.astro';
import EtiquetaSiNo from '../components/ui/EtiquetaSiNo.astro';
import reciclar from '../assets/muestra/reciclar.png';
import { campana } from '../data/campana';

// Página de muestra temporal del sistema visual (spec 0002). La reemplaza la portada en la parte #5.
const { encuesta, guia, porque } = campana;
const giros = ['izquierda', 'recto', 'derecha'] as const;
---

<Base titulo={campana.meta.titulo} descripcion={campana.meta.descripcion}>
  <main>
    <Seccion id="inicio" ancho="texto">
      <TarjetaCinta cinta="esquinas" giro="izquierda" as="article">
        <h1 class="marca">{campana.nombre}</h1>
        <p class="lema">{campana.lema}</p>
        <p class="nota">Muestra temporal del sistema visual.</p>
      </TarjetaCinta>
    </Seccion>

    <Seccion id="informacion">
      <TituloSeccion>{encuesta.titulo}</TituloSeccion>
      <div class="grilla">
        <TarjetaCinta giro="izquierda">
          <ListaIconos
            items={[
              { icono: 'clipboard-list', texto: encuesta.metodo[0] },
              { icono: 'users', texto: encuesta.metodo[1] },
              { icono: 'trending-up', texto: encuesta.metodo[2] },
            ]}
          />
        </TarjetaCinta>
        <TarjetaCinta cinta="lados">
          <p>{porque.puntos[0]} {porque.puntos[1]}</p>
        </TarjetaCinta>
        <TarjetaCinta papel="salvia" cinta="esquinas" giro="derecha">
          <p>{porque.puntos[2]}</p>
        </TarjetaCinta>
      </div>
    </Seccion>

    <Seccion id="datos">
      <TituloSeccion>Datos de la encuesta</TituloSeccion>
      <div class="grilla">
        {encuesta.datos.slice(0, 3).map((dato, i) => (
          <BloqueDato valor={dato.valor} frase={dato.frase} detalle={'detalle' in dato ? dato.detalle : undefined} giro={giros[i]} />
        ))}
      </div>
    </Seccion>

    <Seccion id="guia">
      <TituloSeccion>¿Va al Ecopunto?</TituloSeccion>
      <div class="grilla">
        <TarjetaCinta giro="derecha">
          <div class="etiquetas">
            <EtiquetaSiNo tipo="si" texto={guia.si.titulo} />
            <p>{guia.si.puntos.slice(0, 5).join(', ')} y más.</p>
            <EtiquetaSiNo tipo="no" texto={guia.no.titulo} />
            <p>{guia.no.puntos.slice(0, 4).join(', ')} y más.</p>
          </div>
        </TarjetaCinta>
        <ImagenMarco src={reciclar} alt="Símbolo de reciclaje en verde." giro="izquierda" cinta="esquinas" />
      </div>
    </Seccion>
  </main>
</Base>

<style>
  .marca {
    font-size: var(--titulo-portada);
    overflow-wrap: anywhere;
  }
  .lema {
    margin-top: var(--espacio-3);
    font-size: var(--texto-base);
    font-weight: 700;
  }
  .nota {
    margin-top: var(--espacio-2);
    font-size: var(--texto-chico);
    color: var(--color-tinta-suave);
  }
  .etiquetas {
    display: grid;
    gap: var(--espacio-3);
    justify-items: start;
  }
</style>
